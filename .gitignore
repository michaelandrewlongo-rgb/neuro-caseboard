__pycache__/
*.pyc
*.egg-info/
.eggs/
# repo-root Python build artifact only — anchored with a leading slash so the
# pattern does not also swallow nested dirs like web/src/components/build/
# (the unanchored form silently kept those out of git and broke the web build).
/build/
dist/
.pytest_cache/
.venv/
venv/
# throwaway venvs created by ci/local-ci.sh and the package job
.local-ci-venv/
.local-ci-pkgvenv/
.ci-venv/
*.pdf
!tests/**/*.pdf
out/
/tmp/
.DS_Store
eval/_outputs/
# regenerable generated-schematic render artifacts (WS-4 eval)
eval/_fig_specs/
# local secrets / environment — never commit (keep .env.example tracked)
.env
.env.*
!.env.example
# GUI council capture artifacts (regenerable)
gui-council/shots/
gui-council/axe/
# local throwaway venvs
.testvenv/
.project-loop/

# chunking benchmark: regenerable extraction cache (machine paths, ~6MB/book)
eval/chunking-benchmark/records_cache/

# WSL/Windows interop artifacts
*Zone.Identifier

# graft's local graph cache — regenerable, not committed (run `graft build`).
graft/

# --- large / private local artifacts (never push: this repo is PUBLIC) ---
# publisher full text for the cerebrovascular corpus (1018 files, ~458MB)
cv_full_text/
# nested autonomous working copy (~426MB)
..neuro-caseboard-autonomous/
# personal local agent state
.hermes/
# eval run artifacts — bulky + regenerable; curated runs already tracked can
# still be committed explicitly with `git add -f`
evaluation/runs/
eval/*.log
eval/displacement-*/
eval/mmr-*/
eval/placebo-pilot/
eval/pubmed-snapshot*/
eval/index-fingerprint.json

# Run-time guard ledgers (see global CLAUDE.md) — never durable documentation.
.run.md
.run-*.md
# Claude Code session transcript dumps accidentally saved into the repo root.
/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*.txt
